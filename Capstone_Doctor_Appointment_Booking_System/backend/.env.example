# Copy this file to .env and replace with your real MongoDB values
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=doctor_appointment

# Or use these if you are connecting with username/password
# MONGODB_USERNAME=your_username
# MONGODB_PASSWORD=your_password
# MONGODB_HOST=your-cluster.mongodb.net
# MONGODB_PORT=27017
# MONGODB_USE_SRV=true
